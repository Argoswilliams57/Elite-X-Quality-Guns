  },
  "license": "All Rights Reserved, Creative Commons Attribution",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.argos_garcia.elitex.fabric.EliteXFabric"
    ],
    "client": [
      "com.argos_garcia.elitex.fabric.client.EliteXCameraAnimation"
    ],
    "modmenu": [
      "com.argos_garcia.elitex.fabric.client.EliteXModMenuIntegration"
    ]
  },
  "mixins": [
    "elitex.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "forgeconfigapiport": "*",
    "tacz": "*"
